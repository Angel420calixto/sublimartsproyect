{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "meta[name=theme-color]",
          "iframe[loading]"
        ]
      }
    ],
    "axe/structure": [
      "default",
      {
        "listitem": "off"
      }
    ],
    "button-type": "off",
    "no-inline-styles": "off",
    "meta-viewport": "off",
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "-webkit-overflow-scrolling",
          "overscroll-behavior",
          "overscroll-behavior: contain",
          "backdrop-filter",
          "-webkit-user-drag",
          "user-select"
        ]
      }
    ]
  }
}